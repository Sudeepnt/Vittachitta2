# Admin login (/adminvct). Both are required: with either missing, login refuses.
# ADMIN_PASSWORD is what you type to sign in. ADMIN_SECRET is a long random string that signs the session
# cookie (for example: openssl rand -hex 32). Never reuse one for the other.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Supabase (run supabase/setup.sql first). Without these the admin opens read-only and the site uses the bundled text.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
