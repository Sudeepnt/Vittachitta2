{
  "framework": null,
  "installCommand": "cd vitthachittha-next && npm ci",
  "buildCommand": "cd vitthachittha-next && STATIC_EXPORT=1 npm run build",
  "outputDirectory": "vitthachittha-next/out",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/rt/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
